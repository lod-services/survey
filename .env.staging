# Staging Environment Configuration

###> symfony/framework-bundle ###
APP_ENV=staging
# Generate secure secret: php bin/console secrets:generate-keys
APP_SECRET=staging_secret_key_replace_with_generated_secure_key
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# PostgreSQL with SSL for staging
DATABASE_URL="postgresql://app:STAGING_PASSWORD@staging-db.example.com:5432/survey_staging?serverVersion=16&charset=utf8&sslmode=require"
###< doctrine/doctrine-bundle ###

###> caching ###
# Redis cluster configuration for staging
REDIS_URL=redis://staging-redis.example.com:6379
MEMCACHED_URL=memcached://staging-memcached.example.com:11211
###< caching ###

###> ssl/tls ###
# SSL/TLS Configuration for staging
DATABASE_SSL_MODE=require
DATABASE_SSL_CERT=/path/to/client-cert.pem
DATABASE_SSL_KEY=/path/to/client-key.pem
DATABASE_SSL_CA=/path/to/ca-cert.pem
###< ssl/tls ###

###> performance ###
# Connection pooling for staging
DATABASE_POOL_MIN=20
DATABASE_POOL_MAX=50
REDIS_TIMEOUT=2
MEMCACHED_TIMEOUT=1
###< performance ###