# Production Environment Configuration

###> symfony/framework-bundle ###
APP_ENV=prod
# CRITICAL: Generate secure secret with: php bin/console secrets:generate-keys
# Use Symfony's secret management system for production
APP_SECRET=%env(resolve:APP_SECRET_FROM_VAULT)%
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# PostgreSQL with SSL and connection pooling for production
# Use read replicas for scalability
DATABASE_URL="postgresql://app:%env(DATABASE_PASSWORD)%@prod-db-primary.example.com:5432/survey_prod?serverVersion=16&charset=utf8&sslmode=require&sslcert=/ssl/client-cert.pem&sslkey=/ssl/client-key.pem&sslrootcert=/ssl/ca-cert.pem"

# Read replica for read-heavy operations
DATABASE_REPLICA_URL="postgresql://app:%env(DATABASE_PASSWORD)%@prod-db-replica.example.com:5432/survey_prod?serverVersion=16&charset=utf8&sslmode=require&sslcert=/ssl/client-cert.pem&sslkey=/ssl/client-key.pem&sslrootcert=/ssl/ca-cert.pem"
###< doctrine/doctrine-bundle ###

###> caching ###
# Redis cluster with failover for production
REDIS_URL=redis://prod-redis-cluster.example.com:6379
REDIS_SENTINEL_URL=redis-sentinel://prod-redis-sentinel.example.com:26379

# Memcached cluster as fallback
MEMCACHED_URL=memcached://prod-memcached-cluster.example.com:11211
###< caching ###

###> ssl/tls ###
# SSL/TLS Configuration for production
DATABASE_SSL_MODE=require
DATABASE_SSL_CERT=/ssl/client-cert.pem
DATABASE_SSL_KEY=/ssl/client-key.pem
DATABASE_SSL_CA=/ssl/ca-cert.pem
DATABASE_SSL_CRL=/ssl/client-crl.pem

# Redis SSL/TLS
REDIS_SSL=true
REDIS_SSL_CERT=/ssl/redis-client-cert.pem
REDIS_SSL_KEY=/ssl/redis-client-key.pem
REDIS_SSL_CA=/ssl/redis-ca-cert.pem
###< ssl/tls ###

###> performance ###
# Production performance settings
DATABASE_POOL_MIN=50
DATABASE_POOL_MAX=100
DATABASE_QUERY_TIMEOUT=30
DATABASE_CONNECTION_TIMEOUT=5

# Cache settings
REDIS_TIMEOUT=5
REDIS_MAX_CONNECTIONS=100
MEMCACHED_TIMEOUT=2
MEMCACHED_COMPRESSION=true

# Application performance
OPCACHE_ENABLE=1
OPCACHE_MEMORY=256
APT_CACHE_ENABLE=1
###< performance ###

###> monitoring ###
# Production monitoring and logging
LOG_LEVEL=error
SENTRY_DSN=%env(SENTRY_DSN)%
NEWRELIC_LICENSE_KEY=%env(NEWRELIC_LICENSE_KEY)%

# Health check endpoints
HEALTH_CHECK_TOKEN=%env(HEALTH_CHECK_TOKEN)%
###< monitoring ###

###> backup ###
# Backup configuration
BACKUP_ENCRYPTION_KEY=%env(BACKUP_ENCRYPTION_KEY)%
BACKUP_S3_BUCKET=%env(BACKUP_S3_BUCKET)%
BACKUP_RETENTION_DAYS=30
###< backup ###