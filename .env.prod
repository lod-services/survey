###> symfony/framework-bundle ###
APP_ENV=prod
# Note: In production, APP_SECRET should be set via environment variables
# APP_SECRET should be a cryptographically secure 64-character string
# Generate with: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=
###< symfony/framework-bundle ###

# HTTPS Configuration
# Ensure HTTPS is available in production environment for HSTS implementation
# Verify SSL certificates are properly configured
HTTPS_ENABLED=true