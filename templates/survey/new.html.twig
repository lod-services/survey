{% extends 'base.html.twig' %}

{% block title %}Create New Survey - AI-Powered{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h2 class="mb-0">🚀 Create New AI-Powered Survey</h2>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-4">
                        Provide basic information about your survey and let our AI help you create engaging, unbiased questions.
                    </p>
                    
                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_label(form.title) }}
                            {{ form_widget(form.title, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.title) }}
                        </div>
                        
                        <div class="mb-3">
                            {{ form_label(form.description) }}
                            {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.description) }}
                        </div>
                        
                        <div class="mb-3">
                            {{ form_label(form.objective) }}
                            <div class="input-group">
                                <span class="input-group-text">🎯</span>
                                {{ form_widget(form.objective, {'attr': {'class': 'form-control', 'placeholder': 'e.g., Understand customer satisfaction with our new product feature'}}) }}
                            </div>
                            {{ form_help(form.objective) }}
                            {{ form_errors(form.objective) }}
                        </div>
                        
                        <div class="mb-4">
                            {{ form_label(form.targetAudience) }}
                            <div class="input-group">
                                <span class="input-group-text">👥</span>
                                {{ form_widget(form.targetAudience, {'attr': {'class': 'form-control', 'placeholder': 'e.g., Existing customers who purchased in the last 3 months'}}) }}
                            </div>
                            {{ form_help(form.targetAudience) }}
                            {{ form_errors(form.targetAudience) }}
                        </div>
                        
                        <div class="alert alert-info">
                            <i class="bi bi-lightbulb"></i>
                            <strong>AI Tip:</strong> The more specific your objective and target audience, the better our AI can generate relevant, engaging questions for your survey.
                        </div>
                        
                        <div class="d-flex justify-content-between">
                            <a href="{{ path('app_survey_index') }}" class="btn btn-secondary">
                                <i class="bi bi-arrow-left"></i> Back to Surveys
                            </a>
                            {{ form_widget(form.save, {'attr': {'class': 'btn btn-primary'}}) }}
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}