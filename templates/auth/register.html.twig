{% extends 'base.html.twig' %}

{% block title %}Register - Survey Gamification{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow">
            <div class="card-header bg-success text-white text-center">
                <h4 class="mb-0">➕ Create Account</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-info">
                    <small>
                        🎮 Join our gamified survey platform and start earning points and achievements!
                    </small>
                </div>

                {{ form_start(form) }}
                    <div class="mb-3">
                        {{ form_label(form.name, 'Full Name', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.name, {'attr': {'class': 'form-control', 'placeholder': 'Enter your full name'}}) }}
                        {{ form_errors(form.name) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.email, 'Email Address', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'Enter your email address'}}) }}
                        {{ form_errors(form.email) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.password.first, 'Password', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.password.first, {'attr': {'class': 'form-control', 'placeholder': 'Choose a secure password'}}) }}
                        {{ form_errors(form.password.first) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.password.second, 'Confirm Password', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.password.second, {'attr': {'class': 'form-control', 'placeholder': 'Repeat your password'}}) }}
                        {{ form_errors(form.password.second) }}
                    </div>

                    <div class="mb-4">
                        {{ form_label(form.timezone, 'Timezone (Optional)', {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.timezone, {'attr': {'class': 'form-select'}}) }}
                        {{ form_errors(form.timezone) }}
                        <div class="form-text">Used for streak calculations and activity tracking.</div>
                    </div>

                    <div class="d-grid">
                        {{ form_widget(form.submit) }}
                    </div>
                {{ form_end(form) }}

                <div class="text-center mt-3">
                    <p class="text-muted">Already have an account?</p>
                    <a href="{{ path('app_login') }}" class="btn btn-outline-primary">
                        🔑 Sign In
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}