{% extends 'base.html.twig' %}

{% block title %}AI-Powered Survey Builder{% endblock %}

{% block body %}
<div class="row">
    <div class="col-md-8">
        <div class="jumbotron bg-gradient-primary text-white p-5 rounded">
            <h1 class="display-4">🧠 AI-Powered Survey Builder</h1>
            <p class="lead">Create professional, unbiased surveys with intelligent AI assistance that helps you ask the right questions.</p>
            <hr class="my-4">
            <p>Revolutionary features powered by artificial intelligence:</p>
            <ul class="mb-4">
                <li>🎯 <strong>Smart Question Generator:</strong> AI suggests relevant questions based on your objectives</li>
                <li>🔍 <strong>Real-time Bias Detection:</strong> Identifies and corrects leading or biased questions</li>
                <li>📊 <strong>Quality Scoring:</strong> Confidence ratings and clarity metrics for every suggestion</li>
                <li>🚀 <strong>Instant Setup:</strong> Get from idea to professional survey in minutes</li>
                <li>♿ <strong>Accessibility First:</strong> Ensures inclusive and accessible question design</li>
            </ul>
            <a href="{{ path('app_survey_index') }}" class="btn btn-light btn-lg">
                <i class="bi bi-rocket"></i> Start Building Surveys
            </a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5>Test Stimulus Controller</h5>
            </div>
            <div class="card-body" data-controller="hello">
                <div class="mb-3">
                    <label for="name" class="form-label">Your Name:</label>
                    <input type="text" id="name" class="form-control" data-hello-target="name" placeholder="Enter your name">
                </div>
                <button type="button" class="btn btn-primary" data-action="click->hello#greet">Say Hello</button>
                <div class="mt-3">
                    <div data-hello-target="output" class="alert alert-success" style="display: none;"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5>Bootstrap Components Test</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4">
                        <div class="alert alert-info" role="alert">
                            <h6 class="alert-heading">Information</h6>
                            This is a Bootstrap alert component.
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="btn-group" role="group">
                            <button type="button" class="btn btn-outline-primary">Button 1</button>
                            <button type="button" class="btn btn-outline-primary">Button 2</button>
                            <button type="button" class="btn btn-outline-primary">Button 3</button>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="progress">
                            <div class="progress-bar" role="progressbar" style="width: 75%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5>Development Information</h5>
            </div>
            <div class="card-body">
                <p><strong>Environment:</strong> {{ app.environment }}</p>
                <p><strong>Debug Mode:</strong> {{ app.debug ? 'Enabled' : 'Disabled' }}</p>
                <p><strong>Controller:</strong> {{ controller_name }}</p>
                {% if app.debug %}
                    <div class="alert alert-warning">
                        <strong>Web Profiler:</strong> Check the bottom of the page for the profiler toolbar.
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}