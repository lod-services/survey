# Environment Configuration Template for Survey Application
# =======================================================
# 
# This file serves as a template for environment configuration.
# Copy this file to create your environment-specific configuration:
#   - For development: cp .env.example .env.dev
#   - For testing: cp .env.example .env.test  
#   - For production: cp .env.example .env.prod
#
# SECURITY WARNING: Never commit actual secrets to version control!
# The .gitignore file excludes environment files with secrets.
#
# For more information on Symfony environment configuration:
# https://symfony.com/doc/current/configuration.html#configuration-environments

###> symfony/framework-bundle ###

# Application Environment
# ========================
# Determines which configuration set to use (dev, test, prod)
# Values: dev | test | prod
# Default: dev
APP_ENV=dev

# Application Debug Mode  
# ======================
# Enable/disable debug mode and detailed error reporting
# Values: true | false | 1 | 0
# Default: true (for dev), false (for prod)
# WARNING: NEVER enable debug mode in production!
APP_DEBUG=true

# Application Secret Key
# ======================
# CRITICAL: This secret is used for cryptographic operations including:
# - CSRF token generation and validation
# - Session security and encryption  
# - Password hashing salt generation
# - Symfony security component operations
#
# SECURITY REQUIREMENTS:
# - MUST be at least 32 characters long (64+ recommended for production)
# - MUST be cryptographically secure random string
# - MUST be unique per environment
# - MUST NEVER be committed to version control
# - MUST be different between dev/test/staging/prod environments
#
# HOW TO GENERATE SECURE SECRETS:
# Method 1 (OpenSSL): openssl rand -hex 32
# Method 2 (Random):  head -c32 /dev/urandom | base64
# Method 3 (PHP):     php -r "echo bin2hex(random_bytes(32));"
# Method 4 (Online):  Use a secure password generator (min 32 chars)
#
# EXAMPLE FORMAT (DO NOT USE THESE VALUES):
# APP_SECRET=your_secure_random_32_plus_character_secret_key_here_never_commit_real_values
APP_SECRET=

###< symfony/framework-bundle ###

# Additional Environment Variables
# =================================
# Add additional environment variables below as your application grows.
# Common Symfony application variables include:
#
# Database Configuration (when needed):
# DATABASE_URL="mysql://username:password@host:port/database_name"
# 
# Mailer Configuration (when needed):  
# MAILER_DSN=smtp://user:pass@host:port
#
# Cache Configuration (when needed):
# REDIS_URL=redis://localhost:6379
# 
# External API Keys (when needed):
# EXTERNAL_API_KEY=your_api_key_here
#
# Remember: All sensitive values should be generated uniquely per environment
# and never committed to version control!

# Environment-Specific Notes
# ===========================
# Development (.env.dev):
#   - Use shorter, memorable secrets for convenience  
#   - Enable debug mode (APP_DEBUG=true)
#   - Use local database connections
#
# Testing (.env.test):
#   - Use dedicated test secrets (different from dev/prod)
#   - Disable debug mode for accurate testing
#   - Use test database or in-memory storage
#
# Production (.env.prod):
#   - Use maximum security: 64+ character secrets
#   - Disable debug mode (APP_DEBUG=false)
#   - Use environment variable injection (not .env files)
#   - Consider using Symfony Secrets vault for sensitive data
#   - Enable all security hardening options