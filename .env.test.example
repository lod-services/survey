# Test Environment Configuration Template  
# =========================================
#
# Copy this file to .env.test and configure with your actual test values.
# This file can be committed as it contains no secrets.
#
# IMPORTANT: The .env.test file itself is git-ignored to prevent secret commits.

# Test environment variables for the test env
KERNEL_CLASS='App\Kernel'

# Test Secret Key
# ===============
# Generate a secure secret dedicated to testing:
# openssl rand -hex 32
#
# REQUIREMENTS:
# - Minimum 32 characters (current placeholder is too short!)
# - Unique to testing environment
# - Different from dev/staging/production secrets
# - Should be stable across test runs for consistency
#
# Example: APP_SECRET='test_your_32_plus_character_testing_secret_here_stable'
APP_SECRET='your_test_secret_here_minimum_32_chars'

# Symfony Test Configuration
SYMFONY_DEPRECATIONS_HELPER=999999

# Test-Specific Configuration
# ============================
# Add test-specific variables here:
# - Test database connections
# - Mock service configurations
# - Test data file paths
# - Disabled external services