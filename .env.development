# Development Environment Configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=dev_secret_key_for_development_only_not_for_prod
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# PostgreSQL (Primary development database)
DATABASE_URL="postgresql://app:dev_password@localhost:5432/survey_dev?serverVersion=16&charset=utf8"

# MySQL (Alternative development database - uncomment to use instead)
# DATABASE_URL="mysql://app:dev_password@localhost:3306/survey_dev?serverVersion=8.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> caching ###
# Redis cache configuration
REDIS_URL=redis://localhost:6379
MEMCACHED_URL=memcached://localhost:11211
###< caching ###

###> database/docker ###
# Docker PostgreSQL configuration
POSTGRES_VERSION=16
POSTGRES_DB=survey_dev
POSTGRES_USER=app
POSTGRES_PASSWORD=dev_password
POSTGRES_PORT=5432

# Docker MySQL configuration
MYSQL_DATABASE=survey_dev
MYSQL_USER=app
MYSQL_PASSWORD=dev_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_PORT=3306

# Docker Redis configuration
REDIS_PORT=6379

# Docker Memcached configuration
MEMCACHED_PORT=11211
MEMCACHED_MEMORY=64
###< database/docker ###