# Development Environment Configuration Template
# ==============================================
# 
# Copy this file to .env.dev and configure with your actual development values.
# This file can be committed as it contains no secrets.
#
# IMPORTANT: The .env.dev file itself is git-ignored to prevent secret commits.

###> symfony/framework-bundle ###

# Development Environment Settings
APP_ENV=dev
APP_DEBUG=true

# Development Secret Key
# ======================
# Generate a secure secret for development use:
# openssl rand -hex 32
# 
# REQUIREMENTS:
# - Minimum 32 characters
# - Unique to your development environment  
# - Different from test/staging/production secrets
#
# Example: APP_SECRET=dev_your_32_plus_character_development_secret_here
APP_SECRET=your_development_secret_here_min_32_chars

###< symfony/framework-bundle ###

# Development-Specific Configuration
# ===================================
# Add development-specific variables here:
# - Local database connections
# - Debug tools configuration
# - Development API endpoints
# - Local service URLs