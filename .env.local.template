# .env.local.template
# ==================
# Local Environment Configuration Template
# Copy this file to .env.local and configure your local development settings
#
# IMPORTANT: .env.local is git-ignored and should contain your actual secrets
# DO NOT commit .env.local to version control

###> SECURITY CONFIGURATION ###
# APP_SECRET: Cryptographically secure secret for session encryption and CSRF protection
# 
# SECURITY REQUIREMENTS:
# - Minimum length: 64 characters (for base64 encoding)
# - Minimum entropy: 256 bits (32 bytes)
# - Must be cryptographically secure random data
#
# GENERATION COMMANDS (choose one):
# For base64 encoding (recommended):
APP_SECRET=
# Generate with: openssl rand -base64 32
# 
# For hexadecimal encoding (alternative):
# Generate with: openssl rand -hex 32
#
# Example (DO NOT USE THIS EXACT VALUE):
# APP_SECRET=Kj8vM2Lp9qR7sT3uY6wZ1eA4bC8fG5hI0nO2mQ7rT9vX
###< SECURITY CONFIGURATION ###

###> DATABASE CONFIGURATION ###
# Configure your local database connection
# Example for MySQL/MariaDB:
# DATABASE_URL="mysql://user:password@127.0.0.1:3306/survey_db?serverVersion=8.0.32&charset=utf8mb4"
#
# Example for PostgreSQL:
# DATABASE_URL="postgresql://user:password@127.0.0.1:5432/survey_db?serverVersion=15&charset=utf8"
#
# Example for SQLite (for local development):
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
DATABASE_URL=

###< DATABASE CONFIGURATION ###

###> LOCAL DEVELOPMENT SETTINGS ###
# Environment mode (keep as 'dev' for local development)
APP_ENV=dev

# Debug mode (enable for local development)
APP_DEBUG=1

# Mailer configuration for local development
# Use null:// for local development (emails won't be sent)
MAILER_DSN=null://localhost

# Redis configuration (if using Redis for sessions/cache)
# REDIS_URL=redis://localhost:6379
###< LOCAL DEVELOPMENT SETTINGS ###

###> OPTIONAL THIRD-PARTY SERVICES ###
# Configure external services for local development
# Only uncomment and configure if needed for your local setup

# OAuth providers (if implemented)
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret

# File storage (if using external storage)
# AWS_S3_BUCKET=your_bucket_name
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key

# External APIs
# API_KEY_EXTERNAL_SERVICE=your_api_key
###< OPTIONAL THIRD-PARTY SERVICES ###

# ==============================================================================
# SETUP INSTRUCTIONS:
# ==============================================================================
# 1. Copy this file: cp .env.local.template .env.local
# 2. Generate a secure APP_SECRET: openssl rand -base64 32
# 3. Paste the generated secret after APP_SECRET=
# 4. Configure your database connection in DATABASE_URL
# 5. Adjust other settings as needed for your local setup
# 6. Verify configuration: php csrf_verification.php
#
# SECURITY REMINDERS:
# - Never commit .env.local to version control
# - Use strong, unique secrets for each environment
# - Regularly rotate secrets in production
# - Keep local secrets separate from production secrets
# ==============================================================================