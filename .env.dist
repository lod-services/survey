# ================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ================================================================
# 
# This file serves as a template for environment configuration.
# Copy this file to .env and configure the values below.
#
# SECURITY NOTICE:
# - NEVER commit .env files to version control
# - .env files contain sensitive configuration data
# - Use strong, randomly generated secrets for production
#
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.dist .env
# 2. Generate a secure APP_SECRET (see instructions below)
# 3. Configure other environment variables as needed
# 4. Ensure .env files are in .gitignore (they are!)
#
# ================================================================

# ----------------------------------------------------------------
# APPLICATION ENVIRONMENT
# ----------------------------------------------------------------
# Set the application environment mode
# Values: dev, prod, test
# - dev: Development mode with debugging enabled
# - prod: Production mode with optimizations
# - test: Testing mode for automated tests
APP_ENV=dev

# ----------------------------------------------------------------
# DEBUG MODE
# ----------------------------------------------------------------
# Enable/disable debug mode
# Values: true, false, 1, 0
# WARNING: ALWAYS set to false in production
APP_DEBUG=true

# ----------------------------------------------------------------
# APPLICATION SECRET (CRITICAL)
# ----------------------------------------------------------------
# This secret is used for:
# - CSRF token generation and validation
# - Session security and encryption  
# - Framework security features
# - Cryptographic operations
#
# SECURITY REQUIREMENTS:
# - Minimum 32 characters (64+ recommended for production)
# - High entropy random string
# - Use cryptographically secure character set: [A-Za-z0-9+/=]
# - Generate new secret for each environment
# - NEVER reuse secrets across environments
#
# GENERATION METHODS:
# 
# Method 1 - Using PHP (recommended):
# php -r "echo bin2hex(random_bytes(32)) . PHP_EOL;"
#
# Method 2 - Using OpenSSL:
# openssl rand -hex 32
#
# Method 3 - Using Symfony Console:
# php bin/console secrets:generate-keys
#
# Method 4 - Online (use with caution):
# Generate at: https://generate-secret.vercel.app/32
# WARNING: Only use trusted generators and verify randomness
#
# PRODUCTION SECURITY:
# - Use minimum 64 character secrets in production
# - Consider using Symfony's secrets management for production:
#   https://symfony.com/doc/current/configuration/secrets.html
# - Rotate secrets regularly (quarterly recommended)
# - Use different secrets for different environments
#
# Example (DO NOT USE - GENERATE YOUR OWN):
APP_SECRET=REPLACE_WITH_STRONG_32_PLUS_CHARACTER_SECRET

# ----------------------------------------------------------------
# DATABASE CONFIGURATION (if applicable)
# ----------------------------------------------------------------
# Uncomment and configure if your application uses a database
# 
# # Database URL for Doctrine ORM
# # Format: DATABASE_URL="mysql://username:password@host:port/database"
# # Examples:
# #   MySQL: DATABASE_URL="mysql://app:secret@localhost:3306/survey_app"
# #   PostgreSQL: DATABASE_URL="postgresql://app:secret@localhost:5432/survey_app"
# #   SQLite: DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
# DATABASE_URL="mysql://app:secret@localhost:3306/survey_app"

# ----------------------------------------------------------------
# MAILER CONFIGURATION (if applicable)
# ----------------------------------------------------------------
# Uncomment and configure if your application sends emails
#
# # Mailer DSN for sending emails
# # Examples:
# #   SMTP: MAILER_DSN="smtp://user:pass@smtp.example.com:587"
# #   Gmail: MAILER_DSN="gmail+smtp://user:pass@default"
# #   SendGrid: MAILER_DSN="sendgrid+smtp://apikey:SG.xxx@default"
# MAILER_DSN="smtp://localhost:1025"

# ----------------------------------------------------------------
# CACHE CONFIGURATION (if applicable)
# ----------------------------------------------------------------
# Uncomment and configure if your application uses external caching
#
# # Redis cache
# REDIS_URL="redis://localhost:6379"
#
# # Memcached
# MEMCACHED_URL="memcached://localhost:11211"

# ----------------------------------------------------------------
# SESSION CONFIGURATION (if applicable)
# ----------------------------------------------------------------
# Uncomment and configure for custom session handling
#
# # Session handler (file, redis, memcached, etc.)
# SESSION_HANDLER="file"
# SESSION_SAVE_PATH="/tmp/sessions"

# ----------------------------------------------------------------
# EXTERNAL SERVICES (if applicable)
# ----------------------------------------------------------------
# Add your external service API keys and configuration here
# ALWAYS use environment variables for sensitive credentials
#
# # Example external API
# # EXTERNAL_API_KEY="your_api_key_here"
# # EXTERNAL_API_URL="https://api.example.com"

# ================================================================
# ENVIRONMENT VARIABLE PRECEDENCE
# ================================================================
# Symfony loads environment variables in this order (highest priority first):
# 1. System environment variables (export VAR=value)
# 2. .env.local (local overrides, ignored by git)
# 3. .env.$APP_ENV.local (environment-specific local overrides)
# 4. .env.$APP_ENV (environment-specific defaults)
# 5. .env (this file's copy - general defaults)
#
# BEST PRACTICES:
# - Use .env.dist for documentation and safe defaults
# - Use .env for local development configuration
# - Use .env.local for local overrides (ignored by git)
# - Use system environment variables in production
# - NEVER commit files containing real secrets
#
# ================================================================
# SECURITY CHECKLIST
# ================================================================
# 
# BEFORE COMMITTING:
# □ Verify .env files are in .gitignore
# □ Ensure no real secrets are in this template
# □ All example values are clearly marked as examples
# □ Security warnings are prominently displayed
#
# AFTER SETUP:
# □ Generated strong, unique APP_SECRET
# □ Verified application starts successfully
# □ Tested CSRF protection is working
# □ Confirmed no environment files are tracked by git
#
# PRODUCTION DEPLOYMENT:
# □ Use system environment variables or Symfony secrets
# □ Generate production-specific secrets (min 64 chars)
# □ Verify debug mode is disabled (APP_DEBUG=false)
# □ Set environment to production (APP_ENV=prod)
# □ Test secret rotation procedures
#
# ================================================================
# SECRET ROTATION PROCEDURES
# ================================================================
#
# If you suspect your secrets have been compromised:
#
# 1. IMMEDIATE RESPONSE:
#    - Generate new APP_SECRET immediately
#    - Update all environment files (.env, .env.local, production)
#    - Restart application servers
#    - Invalidate all user sessions
#
# 2. INVESTIGATION:
#    - Check git history for accidentally committed secrets
#    - Review access logs for suspicious activity
#    - Audit all environments using the compromised secret
#
# 3. REMEDIATION:
#    - If secrets were committed to git:
#      * Use git filter-branch or BFG Repo-Cleaner to remove history
#      * Force push to all remotes (coordinate with team)
#      * Notify all team members to re-clone repository
#    - Update documentation with new procedures
#    - Consider implementing Symfony secrets management
#
# 4. PREVENTION:
#    - Regular secret rotation (quarterly)
#    - Automated checks for committed secrets
#    - Team training on security best practices
#    - Pre-commit hooks to prevent secret commits
#
# ================================================================